# Optional: a Claude API key from https://console.anthropic.com.
# Leave it empty for the free lookup: online dictionaries + offline Persian (see README).
ANTHROPIC_API_KEY=

# Optional: a Merriam-Webster Learner's Dictionary key from https://dictionaryapi.com.
# Without a Claude key, English definitions come from Merriam-Webster first,
# then the Free Dictionary API, then Wiktionary.
MERRIAM_WEBSTER_KEY=

# Accounts: everyone signs in with their own username and password, and has
# their own dictionary. The first account (yours) can be created freely and
# keeps the words saved before accounts existed. After that, new accounts need
# this invite code; leave it empty to keep sign-up closed. When it's set, the
# first account needs it too, so set it before putting the app online.
SIGNUP_CODE=

# Set when an https proxy or tunnel sits in front of the app, so sign-in
# cookies are marked Secure and attempt limits see real addresses:
# "loopback" for a tunnel on the same computer (cloudflared), "1" for most hosts.
TRUST_PROXY=

# Docker (docker-compose.yml) only:
# Your domain name, for automatic https with `docker compose --profile https up -d`.
DOMAIN=
# 127.0.0.1 keeps port 3000 reachable only from this server (when Caddy or
# another proxy here serves https); leave empty to open it to the network.
BIND=
# The server port the app is published on (default 3000).
HOST_PORT=

# Without Docker (optional)
PORT=3000
DATA_DIR=data
