# Optional: a Claude API key from https://console.anthropic.com.
# Leave it empty for the free lookup: online dictionaries + offline Persian (see README).
ANTHROPIC_API_KEY=

# Optional: a Merriam-Webster Learner's Dictionary key from https://dictionaryapi.com.
# Without a Claude key, English definitions come from Merriam-Webster first,
# then the Free Dictionary API, then Wiktionary.
MERRIAM_WEBSTER_KEY=

# Optional: when set, the app asks for this password before showing your dictionary.
# Set it whenever the app is reachable from the internet.
APP_PASSWORD=

# Optional
PORT=3000
DATA_DIR=data
